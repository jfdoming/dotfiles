set nocompatible
filetype off " required for Vundle to work

set rtp+=~/.vim/bundle/Vundle.vim
call vundle#begin()

Plugin 'http://github.com/VundleVim/Vundle.vim'

" This plugin is a duplicate of the below plugin!
""Plugin 'chemzqm/vim-jsx-improve'

""Plugin 'leafgarland/typescript-vim'
""Plugin 'peitalin/vim-jsx-typescript'

Plugin 'http://github.com/morhetz/gruvbox'
Plugin 'http://github.com/vim-airline/vim-airline'
Plugin 'http://github.com/airblade/vim-gitgutter'
Plugin 'http://github.com/vim-syntastic/syntastic'
Plugin 'http://github.com/rodjek/vim-puppet'

" This plugin is very nice, but it has a huge bug (at least on Windows 10)!
" See https://github.com/prettier/vim-prettier/issues/214
""Plugin 'prettier/vim-prettier'

call vundle#end()
filetype plugin indent on
